{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usdata",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "docs.usdata.dev", "custom_domain": true }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "usdata" }],
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
