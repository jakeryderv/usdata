{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usdata-home",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "usdata.dev", "custom_domain": true }],
  "assets": { "directory": "home", "not_found_handling": "404-page" },
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
